generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Basic Information
  firstName String
  lastName  String
  email     String @unique
  password  String
  role      String @default("STUDENT") // STUDENT, TEACHER, ADMIN

  // Profile Information
  profileImage      String?
  bio               String?
  location          String?
  preferredLanguage String  @default("EN") // EN, RW, FR, SW

  // Accessibility Preferences
  screenReader      Boolean @default(false)
  highContrast      Boolean @default(false)
  largeText         Boolean @default(false)
  audioDescriptions Boolean @default(false)
  signLanguage      Boolean @default(false)
  brailleSupport    Boolean @default(false)

  // Status
  isActive  Boolean   @default(true)
  lastLogin DateTime?

  // Relations
  coursesCreated    Course[]           @relation("CourseInstructor")
  coursesAuthored   Course[]           @relation("CourseCreator")
  coursesEnrolled   CourseEnrollment[]
  coursesCompleted  CourseCompletion[]
  resourcesUploaded Resource[]         @relation("ResourceUploader")
  courseRatings     CourseRating[]
  resourceRatings   ResourceRating[]
  achievements      Achievement[]

  @@map("users")
}

model Course {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Basic Information
  title       String
  description String
  category    String // TECHNOLOGY, LANGUAGE, MATHEMATICS, SCIENCE, ARTS, BUSINESS, HEALTH, SOCIAL_STUDIES, SPECIAL_EDUCATION
  level       String // BEGINNER, INTERMEDIATE, ADVANCED
  language    String @default("EN") // EN, RW, FR, SW

  // Media
  thumbnailUrl String?
  duration     Int? // total duration in minutes

  // Accessibility Features
  audioDescriptions Boolean @default(false)
  signLanguage      Boolean @default(false)
  brailleSupport    Boolean @default(false)
  tactileDiagrams   Boolean @default(false)
  closedCaptions    Boolean @default(false)

  // Status
  isPublished Boolean @default(false)
  tags        String? // JSON string for tags array

  // Relations
  instructorId String
  instructor   User   @relation("CourseInstructor", fields: [instructorId], references: [id])

  createdById String
  createdBy   User   @relation("CourseCreator", fields: [createdById], references: [id])

  lessons     Lesson[]
  enrollments CourseEnrollment[]
  completions CourseCompletion[]
  ratings     CourseRating[]

  @@map("courses")
}

model Lesson {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title       String
  description String?
  content     String?
  videoUrl    String?
  duration    Int? // duration in minutes
  orderIndex  Int

  // Accessibility
  transcript       String?
  audioDescription String?

  // Relations
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  resources Resource[]

  @@map("lessons")
}

model Resource {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title       String
  description String?
  type        String // VIDEO, AUDIO, DOCUMENT, IMAGE, INTERACTIVE, ASSESSMENT
  url         String
  fileSize    Int?
  mimeType    String?

  // Accessibility
  altText    String?
  transcript String?

  // Relations
  uploaderId String
  uploader   User   @relation("ResourceUploader", fields: [uploaderId], references: [id])

  lessonId String?
  lesson   Lesson? @relation(fields: [lessonId], references: [id])

  ratings ResourceRating[]

  @@map("resources")
}

model CourseEnrollment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  courseId String
  course   Course @relation(fields: [courseId], references: [id])

  progress Float @default(0) // 0-100 percentage

  @@unique([userId, courseId])
  @@map("course_enrollments")
}

model CourseCompletion {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  courseId String
  course   Course @relation(fields: [courseId], references: [id])

  score       Float?
  completedAt DateTime @default(now())

  @@unique([userId, courseId])
  @@map("course_completions")
}

model CourseRating {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rating Int // 1-5
  review String?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  courseId String
  course   Course @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
  @@map("course_ratings")
}

model ResourceRating {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rating Int // 1-5
  review String?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id])

  @@unique([userId, resourceId])
  @@map("resource_ratings")
}

model Achievement {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  title       String
  description String
  icon        String?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  earnedAt DateTime @default(now())

  @@map("achievements")
}
